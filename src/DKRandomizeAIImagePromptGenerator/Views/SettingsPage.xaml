<Page
    x:Class="DKRandomizeAIImagePromptGenerator.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="32" MaxWidth="980" HorizontalAlignment="Stretch">
            <StackPanel Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="설정" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Opacity="0.7" Text="앱 표시 방식과 로컬 데이터 관리를 설정합니다." />
                </StackPanel>

                <Border Style="{StaticResource PromptCardStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="테마" FontWeight="SemiBold" />
                            <TextBlock Opacity="0.65" Text="시스템 설정을 따르거나 라이트/다크 테마를 고정합니다." TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="시스템 설정 따름" />
                            <ComboBoxItem Content="라이트" />
                            <ComboBoxItem Content="다크" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PromptCardStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="데이터 백업" FontWeight="SemiBold" />
                            <TextBlock Opacity="0.65" Text="프롬프트 데이터와 대표 이미지를 하나의 백업 파일로 보관합니다." TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="백업" />
                            <Button Content="복원" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PromptCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="정보" FontWeight="SemiBold" />
                        <TextBlock Text="DK Randomize AI Image Prompt Generator" />
                        <TextBlock Opacity="0.65" Text="초기 개발 버전" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
