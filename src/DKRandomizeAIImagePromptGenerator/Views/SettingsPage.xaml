<Page
    x:Class="DKRandomizeAIImagePromptGenerator.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollMode="Enabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" MaxWidth="980" HorizontalAlignment="Stretch">
            <StackPanel Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="설정" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Opacity="0.7" Text="앱 표시 방식과 로컬 데이터 관리를 설정합니다." />
                </StackPanel>

                <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

                <Border Style="{StaticResource PromptCardStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="테마" FontWeight="SemiBold" />
                            <TextBlock Opacity="0.65" Text="시스템 설정을 따르거나 라이트/다크 테마를 고정합니다." TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="시스템 설정 따름" />
                            <ComboBoxItem Content="라이트" />
                            <ComboBoxItem Content="다크" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PromptCardStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="데이터 백업" FontWeight="SemiBold" />
                            <TextBlock Opacity="0.65" Text="프롬프트, 최근 기록, 대표 이미지와 설정을 ZIP 파일 하나로 보관하거나 복원합니다." TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="BackupButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="백업" Click="Backup_Click" />
                            <Button Content="복원" Click="Restore_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PromptCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="정보" FontWeight="SemiBold" />
                        <TextBlock Text="DK Randomize AI Image Prompt Generator" TextWrapping="Wrap" />
                        <TextBlock x:Name="VersionText" Opacity="0.65" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
