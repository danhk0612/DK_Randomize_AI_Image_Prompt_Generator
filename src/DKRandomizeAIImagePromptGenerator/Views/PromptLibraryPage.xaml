<Page
    x:Class="DKRandomizeAIImagePromptGenerator.Views.PromptLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DKRandomizeAIImagePromptGenerator.Converters"
    xmlns:models="using:DKRandomizeAIImagePromptGenerator.Models">

    <Page.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter" />
    </Page.Resources>

    <Grid Padding="32" MaxWidth="1440" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="프롬프트" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Opacity="0.7" Text="캐릭터, 작가, 추가 프롬프트를 저장하고 빠르게 찾습니다." />
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="NewPrompt_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="새 프롬프트" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" PlaceholderText="제목 또는 Positive / Negative 프롬프트 검색" TextChanged="SearchBox_TextChanged">
                <TextBox.Header><TextBlock Text="검색" /></TextBox.Header>
            </TextBox>

            <TextBox x:Name="TagFilterBox" Grid.Column="1" PlaceholderText="예: fantasy" TextChanged="TagFilterBox_TextChanged">
                <TextBox.Header><TextBlock Text="태그 필터" /></TextBox.Header>
            </TextBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="18">
                <RadioButton x:Name="CharacterCategoryButton" GroupName="PromptCategory" Content="캐릭터" Tag="Character" IsChecked="True" Checked="Category_Checked" />
                <RadioButton GroupName="PromptCategory" Content="작가 / 스타일" Tag="Artist" Checked="Category_Checked" />
                <RadioButton GroupName="PromptCategory" Content="추가" Tag="Additional" Checked="Category_Checked" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="GalleryViewButton" IsChecked="True" Checked="GalleryView_Checked" AutomationProperties.Name="갤러리 보기" ToolTipService.ToolTip="갤러리 보기">
                    <FontIcon Glyph="&#xF0E2;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="ListViewButton" Checked="ListView_Checked" AutomationProperties.Name="목록 보기" ToolTipService.ToolTip="목록 보기">
                    <FontIcon Glyph="&#xEA37;" FontSize="16" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,20,0,32" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <GridView x:Name="PromptGridView" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="PromptGridView_ItemClick" AutomationProperties.Name="프롬프트 갤러리">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0" ItemWidth="252" ItemHeight="224" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:PromptItem">
                            <Border Style="{StaticResource PromptCardStyle}" Margin="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="92" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE91B;" FontSize="30" Opacity="0.35" />
                                            <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="{x:Bind PositivePrompt}" Opacity="0.65" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <ListView x:Name="PromptListView" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="PromptGridView_ItemClick" AutomationProperties.Name="프롬프트 목록" Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PromptItem">
                            <Grid Padding="8" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="72" Height="72" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE91B;" FontSize="24" Opacity="0.3" />
                                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind PositivePrompt}" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind NegativePrompt}" Opacity="0.5" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE8F1;" FontSize="42" Opacity="0.35" />
                    <TextBlock Text="등록된 프롬프트가 없습니다." FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="새 프롬프트를 추가하면 이곳에 표시됩니다." Opacity="0.65" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border x:Name="EditorPane" Grid.Column="1" Width="400" Style="{StaticResource PromptCardStyle}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EditorTitleText" Text="프롬프트 편집" Style="{StaticResource SectionTitleTextStyle}" />
                            <Button Grid.Column="1" Click="CancelEdit_Click" AutomationProperties.Name="프롬프트 편집 닫기" ToolTipService.ToolTip="닫기">
                                <FontIcon Glyph="&#xE711;" />
                            </Button>
                        </Grid>

                        <Border Height="170" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon x:Name="EditorImagePlaceholder" Glyph="&#xE91B;" FontSize="36" Opacity="0.35" />
                                <Image x:Name="EditorImagePreview" Stretch="Uniform" Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="ChooseImage_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="14" />
                                    <TextBlock Text="대표 이미지 선택" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveImageButton" Content="이미지 제거" Click="RemoveImage_Click" IsEnabled="False" />
                        </StackPanel>

                        <TextBox x:Name="TitleBox" Header="제목" PlaceholderText="구분하기 쉬운 제목" />
                        <TextBlock x:Name="TitleValidationText" Text="제목을 입력해야 합니다." Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                        <TextBox x:Name="PositiveBox" Header="Positive Prompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" VerticalContentAlignment="Top" />
                        <TextBox x:Name="NegativeBox" Header="Negative Prompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalContentAlignment="Top" />
                        <TextBox x:Name="TagsBox" Header="태그" PlaceholderText="쉼표로 구분: fantasy, sword" />
                        <TextBox x:Name="MemoBox" Header="메모" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" VerticalContentAlignment="Top" />

                        <Grid Margin="0,8,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DuplicateButton" Content="복제" Click="DuplicatePrompt_Click" Visibility="Collapsed" />
                            <Button x:Name="DeleteButton" Grid.Column="1" Content="삭제" Click="DeletePrompt_Click" Visibility="Collapsed" />
                            <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Content="저장" Click="SavePrompt_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
