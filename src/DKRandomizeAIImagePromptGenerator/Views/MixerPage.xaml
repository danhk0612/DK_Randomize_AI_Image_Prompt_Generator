<Page
    x:Class="DKRandomizeAIImagePromptGenerator.Views.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DKRandomizeAIImagePromptGenerator.Converters"
    xmlns:models="using:DKRandomizeAIImagePromptGenerator.Models">

    <Page.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter" />

        <DataTemplate x:Key="PromptPickerItemTemplate" x:DataType="models:PromptItem">
            <Grid Padding="4" ColumnSpacing="10" MinHeight="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="52"
                    Height="52"
                    CornerRadius="6"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE91B;" FontSize="20" Opacity="0.3" />
                        <Image
                            Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                            Stretch="Uniform" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        Text="{x:Bind Title}"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind Memo}"
                        Opacity="0.62"
                        FontSize="12"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="2" />
                    <ItemsControl ItemsSource="{x:Bind Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="6,2"
                                    CornerRadius="8"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <TextBlock
                                        Text="{Binding}"
                                        FontSize="11"
                                        Opacity="0.72" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Stretch"
        VerticalScrollMode="Auto"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,28,24,32" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="프롬프트 조합" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Opacity="0.7" Text="캐릭터, 작가, 추가 프롬프트를 고정하거나 랜덤으로 조합합니다." />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,24,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PromptCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="캐릭터" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Height="132" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE91B;" FontSize="32" Opacity="0.38" />
                                <Image x:Name="CharacterImage" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CharacterTitle" Text="선택된 캐릭터 없음" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CharacterMemo" Opacity="0.62" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                        <ComboBox
                            x:Name="CharacterPromptCombo"
                            Header="직접 선택"
                            ItemsSource="{x:Bind ViewModel.CharacterItems, Mode=OneWay}"
                            ItemTemplate="{StaticResource PromptPickerItemTemplate}"
                            MaxDropDownHeight="420"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="CharacterPromptCombo_SelectionChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CharacterModeCombo" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="CharacterModeCombo_SelectionChanged">
                                <ComboBoxItem Content="고정" />
                                <ComboBoxItem Content="랜덤" />
                                <ComboBoxItem Content="미사용" />
                            </ComboBox>
                            <Button x:Name="CharacterRandomButton" Grid.Column="1" Content="다시" Click="CharacterRandom_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PromptCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="작가 / 스타일" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Height="132" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE790;" FontSize="32" Opacity="0.38" />
                                <Image x:Name="ArtistImage" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ArtistTitle" Text="선택된 작가 없음" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistMemo" Opacity="0.62" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                        <ComboBox
                            x:Name="ArtistPromptCombo"
                            Header="직접 선택"
                            ItemsSource="{x:Bind ViewModel.ArtistItems, Mode=OneWay}"
                            ItemTemplate="{StaticResource PromptPickerItemTemplate}"
                            MaxDropDownHeight="420"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="ArtistPromptCombo_SelectionChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ArtistModeCombo" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="ArtistModeCombo_SelectionChanged">
                                <ComboBoxItem Content="고정" />
                                <ComboBoxItem Content="랜덤" />
                                <ComboBoxItem Content="미사용" />
                            </ComboBox>
                            <Button x:Name="ArtistRandomButton" Grid.Column="1" Content="다시" Click="ArtistRandom_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PromptCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="추가" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Height="132" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE710;" FontSize="32" Opacity="0.38" />
                                <Image x:Name="AdditionalImage" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="AdditionalTitle" Text="선택된 추가 프롬프트 없음" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AdditionalMemo" Opacity="0.62" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                        <ComboBox
                            x:Name="AdditionalPromptCombo"
                            Header="직접 선택"
                            ItemsSource="{x:Bind ViewModel.AdditionalItems, Mode=OneWay}"
                            ItemTemplate="{StaticResource PromptPickerItemTemplate}"
                            MaxDropDownHeight="420"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="AdditionalPromptCombo_SelectionChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AdditionalModeCombo" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="AdditionalModeCombo_SelectionChanged">
                                <ComboBoxItem Content="고정" />
                                <ComboBoxItem Content="랜덤" />
                                <ComboBoxItem Content="미사용" />
                            </ComboBox>
                            <Button x:Name="AdditionalRandomButton" Grid.Column="1" Content="다시" Click="AdditionalRandom_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Button Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="RandomizeAll_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE14B;" FontSize="14" />
                    <TextBlock Text="전체 다시 조합" />
                </StackPanel>
            </Button>

            <Grid Grid.Row="3" Margin="0,24,0,0" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Positive" Style="{StaticResource SectionTitleTextStyle}" />
                        <Button HorizontalAlignment="Right" Content="복사" Click="CopyPositive_Click" />
                    </Grid>
                    <TextBox x:Name="PositiveOutput" AcceptsReturn="True" MinHeight="190" TextWrapping="Wrap" VerticalContentAlignment="Top" PlaceholderText="조합된 Positive 프롬프트가 여기에 표시됩니다." />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="8">
                    <Grid>
                        <TextBlock Text="Negative" Style="{StaticResource SectionTitleTextStyle}" />
                        <Button HorizontalAlignment="Right" Content="복사" Click="CopyNegative_Click" />
                    </Grid>
                    <TextBox x:Name="NegativeOutput" AcceptsReturn="True" MinHeight="150" TextWrapping="Wrap" VerticalContentAlignment="Top" PlaceholderText="조합된 Negative 프롬프트가 여기에 표시됩니다." />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="0,16,0,32">
                <InfoBar x:Name="HistorySavedInfoBar" IsOpen="False" Severity="Success" Title="최근 기록에 저장했습니다." IsClosable="True" />
                <Button HorizontalAlignment="Right" Content="현재 결과 기록 저장" Click="SaveHistory_Click" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
