<Page
    x:Class="DKRandomizeAIImagePromptGenerator.Views.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="32" MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="프롬프트 조합" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    Opacity="0.7"
                    Text="캐릭터, 작가, 추가 프롬프트를 고정하거나 랜덤으로 조합합니다." />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,24,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PromptCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="캐릭터" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Height="132" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE91B;" FontSize="32" Opacity="0.45" />
                            </Grid>
                        </Border>
                        <TextBlock Text="선택된 캐릭터 없음" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox SelectedIndex="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="고정" />
                                <ComboBoxItem Content="랜덤" />
                                <ComboBoxItem Content="미사용" />
                            </ComboBox>
                            <Button Grid.Column="1" Content="다시" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PromptCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="작가" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Height="132" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE790;" FontSize="32" Opacity="0.45" />
                            </Grid>
                        </Border>
                        <TextBlock Text="선택된 작가 없음" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox SelectedIndex="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="고정" />
                                <ComboBoxItem Content="랜덤" />
                                <ComboBoxItem Content="미사용" />
                            </ComboBox>
                            <Button Grid.Column="1" Content="다시" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PromptCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="추가" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Height="132" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE710;" FontSize="32" Opacity="0.45" />
                            </Grid>
                        </Border>
                        <TextBlock Text="선택된 추가 프롬프트 없음" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox SelectedIndex="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="고정" />
                                <ComboBoxItem Content="랜덤" />
                                <ComboBoxItem Content="미사용" />
                            </ComboBox>
                            <Button Grid.Column="1" Content="다시" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Button
                Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource AccentButtonStyle}"
                Content="전체 다시 조합" />

            <Grid Grid.Row="3" Margin="0,24,0,32" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Positive" Style="{StaticResource SectionTitleTextStyle}" />
                        <Button HorizontalAlignment="Right" Content="복사" />
                    </Grid>
                    <TextBox
                        AcceptsReturn="True"
                        MinHeight="180"
                        TextWrapping="Wrap"
                        PlaceholderText="조합된 Positive 프롬프트가 여기에 표시됩니다." />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8">
                    <Grid>
                        <TextBlock Text="Negative" Style="{StaticResource SectionTitleTextStyle}" />
                        <Button HorizontalAlignment="Right" Content="복사" />
                    </Grid>
                    <TextBox
                        AcceptsReturn="True"
                        MinHeight="140"
                        TextWrapping="Wrap"
                        PlaceholderText="조합된 Negative 프롬프트가 여기에 표시됩니다." />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
