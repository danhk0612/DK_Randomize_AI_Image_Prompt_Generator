<Page
    x:Class="DKRandomizeAIImagePromptGenerator.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DKRandomizeAIImagePromptGenerator.Models">

    <Grid Padding="24" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="최근 기록" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Opacity="0.7" Text="저장 당시 최종 편집된 Positive / Negative 결과를 확인하고 다시 불러옵니다." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,24" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PromptCardStyle}">
                <Grid>
                    <ListView
                        x:Name="HistoryListView"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        SelectionMode="Single"
                        SelectionChanged="HistoryListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CombinationHistory">
                                <StackPanel Padding="4,8" Spacing="5">
                                    <TextBlock Text="{x:Bind CharacterTitleSnapshot, FallbackValue='캐릭터 없음'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ArtistTitleSnapshot, FallbackValue='작가 없음'}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind PositiveText}" Opacity="0.6" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                    <TextBlock Text="{x:Bind CreatedAt}" FontSize="12" Opacity="0.5" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE81C;" FontSize="40" Opacity="0.35" />
                        <TextBlock Text="저장된 기록이 없습니다." FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="DetailPane" Grid.Column="1" Style="{StaticResource PromptCardStyle}" Visibility="Collapsed">
                <ScrollViewer
                    VerticalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="기록 상세" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="CreatedAtText" Opacity="0.6" />
                            </StackPanel>
                            <Button Grid.Column="1" Margin="0,0,8,0" Content="조합 화면으로 복원" Style="{StaticResource AccentButtonStyle}" Click="Restore_Click" />
                            <Button Grid.Column="2" Content="삭제" Click="Delete_Click" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="캐릭터" FontWeight="SemiBold" />
                                <TextBlock x:Name="CharacterTitleText" Text="없음" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="작가 / 스타일" FontWeight="SemiBold" />
                                <TextBlock x:Name="ArtistTitleText" Text="없음" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="추가" FontWeight="SemiBold" />
                                <TextBlock x:Name="AdditionalTitleText" Text="없음" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Positive" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBox x:Name="PositiveTextBox" AcceptsReturn="True" IsReadOnly="True" MinHeight="190" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Negative" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBox x:Name="NegativeTextBox" AcceptsReturn="True" IsReadOnly="True" MinHeight="150" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
