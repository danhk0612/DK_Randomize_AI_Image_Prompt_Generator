<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DKRandomizeAIImagePromptGenerator.App</AssemblyName>
    <RootNamespace>DKRandomizeAIImagePromptGenerator.Wpf</RootNamespace>
    <ApplicationIcon>..\DKRandomizeAIImagePromptGenerator\Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Version>1.0.0-rc.2</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-rc.2</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DKRandomizeAIImagePromptGenerator.Core\DKRandomizeAIImagePromptGenerator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\DKRandomizeAIImagePromptGenerator\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" />
  </ItemGroup>
</Project>
