<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DKRandomizeAIImagePromptGenerator</AssemblyName>
    <RootNamespace>DKRandomizeAIImagePromptGenerator.Wpf</RootNamespace>
    <ApplicationIcon>..\DKRandomizeAIImagePromptGenerator\Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DKRandomizeAIImagePromptGenerator.Core\DKRandomizeAIImagePromptGenerator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\DKRandomizeAIImagePromptGenerator\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" />
  </ItemGroup>
</Project>
