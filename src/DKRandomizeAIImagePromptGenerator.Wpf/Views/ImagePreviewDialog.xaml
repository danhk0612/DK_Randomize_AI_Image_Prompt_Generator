<Window x:Class="DKRandomizeAIImagePromptGenerator.Wpf.Views.ImagePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이미지 크게 보기"
        Width="900" Height="760"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   FontSize="20"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Background="{DynamicResource SurfaceSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       Margin="10" />
                <TextBlock x:Name="EmptyText"
                           Text="표시할 이미지를 불러올 수 없습니다."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <Button Grid.Row="2"
                Content="닫기"
                Width="90"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Click="Close_Click" />
    </Grid>
</Window>