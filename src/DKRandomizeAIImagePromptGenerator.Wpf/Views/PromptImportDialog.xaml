<Window x:Class="DKRandomizeAIImagePromptGenerator.Wpf.Views.PromptImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프롬프트 가져오기"
        Width="820"
        Height="600"
        MinWidth="650"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="프롬프트 가져오기"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="CategoryText"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="TXT 파일명은 제목으로 사용합니다. [Positive] 또는 [Negative] 중 하나는 필수이며, [Tags]와 [Memo]는 선택입니다. 같은 폴더에 같은 이름의 이미지가 있으면 대표 이미지로 가져옵니다." />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0"
                    Orientation="Horizontal">
            <Button x:Name="ChooseFolderButton"
                    Content="폴더 선택"
                    Click="ChooseFolder_Click" />
            <Button x:Name="ChooseFilesButton"
                    Content="파일 선택"
                    Margin="8,0,0,0"
                    Click="ChooseFiles_Click" />
        </StackPanel>

        <TextBlock x:Name="SelectionSummaryText"
                   Grid.Row="2"
                   Margin="0,14,0,8"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="선택된 파일 0개" />

        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Padding="0">
            <DataGrid x:Name="ImportGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="제목"
                                        Binding="{Binding Title}"
                                        Width="2*" />
                    <DataGridTextColumn Header="파일"
                                        Binding="{Binding FileName}"
                                        Width="2*" />
                    <DataGridTextColumn Header="이미지"
                                        Binding="{Binding ImageName}"
                                        Width="1.5*" />
                    <DataGridTextColumn Header="상태"
                                        Binding="{Binding Status}"
                                        Width="2.5*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="ResultSummaryText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="닫기"
                        Click="Close_Click" />
                <Button x:Name="StartImportButton"
                        Content="가져오기 시작"
                        Margin="8,0,0,0"
                        Style="{StaticResource ActionButtonStyle}"
                        IsEnabled="False"
                        Click="StartImport_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
