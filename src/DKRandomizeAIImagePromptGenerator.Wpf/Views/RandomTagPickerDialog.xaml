<Window x:Class="DKRandomizeAIImagePromptGenerator.Wpf.Views.RandomTagPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="랜덤 태그 조건"
        Width="460" Height="560"
        MinWidth="380" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText"
                       Text="랜덤 태그 조건"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="선택한 태그를 모두 가진 프롬프트만 랜덤 후보가 됩니다. 아무 것도 선택하지 않으면 전체가 후보입니다."
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource CardStyle}"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CountText"
                           Margin="4,2,4,8"
                           FontWeight="SemiBold" />
                <ListBox x:Name="TagList"
                         Grid.Row="1"
                         SelectionMode="Multiple"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="랜덤 태그 다중 선택" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="전체 해제"
                    HorizontalAlignment="Left"
                    Click="Clear_Click" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="취소"
                        Width="90"
                        Click="Cancel_Click" />
                <Button Content="적용"
                        Width="90"
                        Margin="8,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>