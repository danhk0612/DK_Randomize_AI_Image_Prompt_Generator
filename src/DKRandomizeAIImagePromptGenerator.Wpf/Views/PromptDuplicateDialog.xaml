<Window x:Class="DKRandomizeAIImagePromptGenerator.Wpf.Views.PromptDuplicateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="중복 / 유사 프롬프트 검사"
        Width="1040"
        Height="650"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="중복 / 유사 프롬프트 검사"
                           Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="CategoryText"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="제목은 비교에서 제외합니다. Positive / Negative 프롬프트가 같으면 완전 중복, 내용 조각 기준 유사도가 95% 이상이면 매우 유사로 표시합니다." />
            </StackPanel>
            <Button Content="다시 검사"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="Refresh_Click" />
        </Grid>

        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Margin="0,16,0,8"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="0">
            <DataGrid x:Name="DuplicateGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="판정"
                                        Binding="{Binding MatchType}"
                                        Width="90" />
                    <DataGridTextColumn Header="유사도"
                                        Binding="{Binding SimilarityText}"
                                        Width="75" />
                    <DataGridTemplateColumn Header="프롬프트 A" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding First.Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FirstPreview}"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxHeight="56" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="프롬프트 B" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Second.Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SecondPreview}"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxHeight="56" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="관리" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Content="A 삭제"
                                            Tag="{Binding First}"
                                            Click="DeletePrompt_Click" />
                                    <Button Content="B 삭제"
                                            Tag="{Binding Second}"
                                            Margin="6,0,0,0"
                                            Click="DeletePrompt_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Content="닫기"
                    HorizontalAlignment="Right"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
