<Window x:Class="DKRandomizeAIImagePromptGenerator.Wpf.Views.PromptPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DKRandomizeAIImagePromptGenerator.Wpf.Converters"
        Title="프롬프트 선택"
        Width="920" Height="680"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter" />
        <DataTemplate x:Key="PromptResultTemplate">
            <Grid Margin="4" MinHeight="72">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="62" Height="62" CornerRadius="7" Background="{DynamicResource SurfaceSecondaryBrush}">
                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Memo}" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxHeight="32" />
                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,3,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                        CornerRadius="7" Padding="5,2" Margin="0,0,4,2">
                                    <TextBlock Text="{Binding}" FontSize="10" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="프롬프트 선택" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="제목, 태그, 메모, Positive, Negative를 통합 검색합니다."
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="SearchBox"
                     Margin="0,14,0,0"
                     TextChanged="SearchBox_TextChanged"
                     AutomationProperties.Name="프롬프트 통합 검색" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SearchResultTitle" Text="검색 결과" FontWeight="SemiBold" Margin="4,2,4,8" />
                    <ListBox x:Name="SearchResultsList"
                             Grid.Row="1"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemTemplate="{StaticResource PromptResultTemplate}"
                             MouseDoubleClick="SearchResultsList_MouseDoubleClick"
                             AutomationProperties.Name="검색 결과" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button Content="추가 →"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="AddSelected_Click" />
                <Button Content="← 제거" Margin="0,8,0,0" Click="RemoveSelected_Click" />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SelectedTitle" Text="선택됨" FontWeight="SemiBold" Margin="4,2,4,8" />
                    <ListBox x:Name="SelectedList"
                             Grid.Row="1"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             ItemTemplate="{StaticResource PromptResultTemplate}"
                             MouseDoubleClick="SelectedList_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="SelectedList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="SelectedList_PreviewMouseMove"
                             DragOver="SelectedList_DragOver"
                             Drop="SelectedList_Drop"
                             AutomationProperties.Name="선택된 프롬프트" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="위" Click="MoveUp_Click" />
                        <Button Content="아래" Margin="6,0,0,0" Click="MoveDown_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Width="90" Click="Cancel_Click" />
                <Button Content="적용" Width="90" Margin="8,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Apply_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
