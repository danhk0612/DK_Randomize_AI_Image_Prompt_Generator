<UserControl x:Class="DKRandomizeAIImagePromptGenerator.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DKRandomizeAIImagePromptGenerator.Wpf.Converters">
    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter" />

        <Style x:Key="HistoryCellTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxHeight" Value="38" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="HistorySecondaryCellTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource HistoryCellTextStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <DataTemplate x:Key="HistoryPromptPreviewTemplate">
            <Border Width="176"
                    Margin="0,0,10,10"
                    Padding="10"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Height="92" Background="{DynamicResource SurfaceSecondaryBrush}">
                        <TextBlock Text="이미지 없음"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" />
                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                               Stretch="Uniform" />
                    </Grid>
                    <TextBlock Text="{Binding CategoryLabel}"
                               Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Title}"
                               Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               MaxHeight="38" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,26,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="최근 기록" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="최근 기록을 위에서 페이지 단위로 확인하고, 선택한 조합의 프롬프트와 최종 결과를 아래에서 봅니다."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="ClearHistoryButton"
                    Grid.Column="1"
                    Content="최근 기록 비우기"
                    VerticalAlignment="Top"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="ClearHistory_Click"
                    AutomationProperties.Name="최근 기록 전체 비우기" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Style="{StaticResource CardStyle}">
            <Grid Height="288">
                <DataGrid x:Name="HistoryListBox"
                          ItemsSource="{Binding Items}"
                          SelectionChanged="HistoryListBox_SelectionChanged"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="최근 기록 목록">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="8,9" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="58" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource SelectionBackgroundBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,8" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="날짜"
                                            Binding="{Binding CreatedAtLocalText}"
                                            Width="130"
                                            ElementStyle="{StaticResource HistorySecondaryCellTextStyle}" />
                        <DataGridTextColumn Header="캐릭터"
                                            Binding="{Binding CharacterTitleSummary}"
                                            Width="155"
                                            ElementStyle="{StaticResource HistoryCellTextStyle}" />
                        <DataGridTextColumn Header="작가 / 스타일"
                                            Binding="{Binding ArtistTitleSummary}"
                                            Width="165"
                                            ElementStyle="{StaticResource HistoryCellTextStyle}" />
                        <DataGridTextColumn Header="추가"
                                            Binding="{Binding AdditionalTitleSummary}"
                                            Width="180"
                                            ElementStyle="{StaticResource HistoryCellTextStyle}" />
                        <DataGridTextColumn Header="Positive 미리보기"
                                            Binding="{Binding PositiveText}"
                                            Width="*"
                                            MinWidth="250"
                                            ElementStyle="{StaticResource HistorySecondaryCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyState"
                           Text="저장된 기록이 없습니다."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="HistoryCountText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="PreviousPageButton"
                        Content="이전"
                        Click="PreviousPage_Click"
                        AutomationProperties.Name="이전 기록 페이지" />
                <TextBlock x:Name="PageText"
                           Width="110"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button x:Name="NextPageButton"
                        Content="다음"
                        Click="NextPage_Click"
                        AutomationProperties.Name="다음 기록 페이지" />
            </StackPanel>
        </Grid>

        <Border x:Name="DetailPane"
                Grid.Row="3"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Visibility="Collapsed">
            <ScrollViewer x:Name="DetailScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="기록 상세" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="CreatedAtText"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Button Content="조합 화면으로 복원"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="Restore_Click"
                                    AutomationProperties.Name="선택한 기록을 조합 화면으로 복원" />
                            <Button Content="삭제"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="Delete_Click"
                                    AutomationProperties.Name="선택한 최근 기록 삭제" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="캐릭터" FontWeight="SemiBold" />
                            <TextBlock x:Name="CharacterModeText"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="CharacterTitleText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="작가 / 스타일" FontWeight="SemiBold" />
                            <TextBlock x:Name="ArtistModeText"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="ArtistTitleText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="추가" FontWeight="SemiBold" />
                            <TextBlock x:Name="AdditionalModeText"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="AdditionalTitleText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="선택된 프롬프트"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,20,0,10" />
                    <ItemsControl x:Name="PromptPreviewItems"
                                  ItemTemplate="{StaticResource HistoryPromptPreviewTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="NoPreviewItemsText"
                               Text="선택된 프롬프트가 없습니다."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="Collapsed" />

                    <TextBlock Text="Positive"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,18,0,0" />
                    <TextBox x:Name="PositiveTextBox"
                             Margin="0,8,0,0"
                             Height="190"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="기록 Positive 결과" />

                    <TextBlock Text="Negative"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,20,0,0" />
                    <TextBox x:Name="NegativeTextBox"
                             Margin="0,8,0,0"
                             Height="150"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="기록 Negative 결과" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
