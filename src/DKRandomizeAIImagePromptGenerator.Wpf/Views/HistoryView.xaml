<UserControl x:Class="DKRandomizeAIImagePromptGenerator.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="최근 기록" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="저장 당시 최종 편집된 Positive / Negative 결과를 확인하고 다시 불러옵니다."
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <ListBox x:Name="HistoryListBox" ItemsSource="{Binding Items}" SelectionChanged="HistoryListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5,7">
                                    <TextBlock Text="{Binding CharacterTitleSnapshot}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ArtistTitleSnapshot}" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PositiveText}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="36" />
                                    <TextBlock Text="{Binding CreatedAt}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyState" Text="저장된 기록이 없습니다." HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <Border x:Name="DetailPane" Grid.Column="2" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <ScrollViewer x:Name="DetailScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="기록 상세" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="CreatedAtText" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Content="조합 화면으로 복원" Style="{StaticResource AccentButtonStyle}" Click="Restore_Click" />
                                <Button Content="삭제" Margin="8,0,0,0" Click="Delete_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="캐릭터" FontWeight="SemiBold" /><TextBlock x:Name="CharacterTitleText" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="작가 / 스타일" FontWeight="SemiBold" /><TextBlock x:Name="ArtistTitleText" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="추가" FontWeight="SemiBold" /><TextBlock x:Name="AdditionalTitleText" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                        </Grid>

                        <TextBlock Text="Positive" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,0" />
                        <TextBox x:Name="PositiveTextBox" Margin="0,8,0,0" Height="190" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="Negative" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,0" />
                        <TextBox x:Name="NegativeTextBox" Margin="0,8,0,0" Height="150" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
